# Required environment variables for quotapp-api
# Copy this file to .env and fill in real values.
# Never commit .env — it is in .gitignore.

# ── Database ──────────────────────────────────────────────────
# Supabase connection string. Use the "Direct connection" string from
# Supabase Dashboard → Settings → Database → Connection string (not the pooler).
# Replace [PASSWORD] with the password set in migration 003_app_role.sql.
DATABASE_URL=jdbc:postgresql://db.<project-ref>.supabase.co:5432/postgres

# Password for the app_role Postgres user (set in 003_app_role.sql).
DATABASE_APP_ROLE_PASSWORD=REPLACE_WITH_STRONG_PASSWORD

# ── Supabase Auth ─────────────────────────────────────────────
# JWKS endpoint — public, no secret.
# Find it: Supabase Dashboard → Settings → API → JWT Settings → JWKS URL
SUPABASE_JWKS_URL=https://<project-ref>.supabase.co/auth/v1/.well-known/jwks.json

# Project URL — public, used for reference.
SUPABASE_URL=https://<project-ref>.supabase.co

# ── Spring profile ────────────────────────────────────────────
# Use 'dev' for local development, leave blank or 'prod' for production.
SPRING_PROFILES_ACTIVE=dev

# ── Speech-to-Text Providers ──────────────────────────────────
# Primary: xAI Grok STT API ($0.10/hour audio, native ITN for numbers & units)
# Console: https://console.x.ai
XAI_API_KEY=xai-REPLACE_WITH_YOUR_KEY

# Benchmark / Fallback: OpenAI Whisper API ($0.36/hour audio)
# Platform: https://platform.openai.com
OPENAI_API_KEY=sk-REPLACE_WITH_YOUR_KEY

# Default STT provider: 'grok' or 'whisper'
DEFAULT_STT_PROVIDER=grok

# ── DO NOT ADD ────────────────────────────────────────────────
# The Supabase service-role key must never appear here.
# It bypasses Row Level Security and must stay server-side admin tooling only.
# SUPABASE_SERVICE_ROLE_KEY=<never put this here>
