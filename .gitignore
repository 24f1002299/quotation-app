# ── Environment & Secrets (NEVER COMMIT) ──────────────────────
.env
**/.env
*.env
!.env.example
!**/.env.example

# ── Backend: Spring Boot & Java ───────────────────────────────
**/target/
target/
*.class
*.jar
*.war

# ── Frontend: Flutter & Dart ──────────────────────────────────
**/build/
build/
**/.dart_tool/
.dart_tool/
**/.flutter-plugins-dependencies
**/.pub-cache/
**/.pub/
**/coverage/

# Android build outputs
**/android/.gradle/
**/android/app/build/
**/android/app/debug/
**/android/app/profile/
**/android/app/release/

# iOS / macOS build outputs
**/ios/Flutter/.last_build_id
**/ios/Pods/
**/macos/Pods/

# ── Node / Supabase CLI (npm) ───────────────────────────────────
# Never commit node_modules — it is rebuilt from package-lock.json.
# DO commit package.json + package-lock.json: they pin the CLI version
# so the whole team runs the same Supabase CLI.
node_modules/
# Studio scratch queries auto-saved by the SQL editor (local only).
supabase/snippets/

# ── IDEs and System files ─────────────────────────────────────
.idea/
*.iml
*.ipr
*.iws
.DS_Store
Thumbs.db
*.log
